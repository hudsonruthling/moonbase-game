addEventListener('keydown',e=>{if(!tOpen)return;if(e.key=='Escape')closeTut();else if(e.key=='ArrowRight'&&tIdx<TSTEPS.length-1){tIdx++;renderTut()}else if(e.key=='ArrowLeft'&&tIdx>0){tIdx--;renderTut()}},true);


